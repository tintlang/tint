// Preview width in % of the window, dragged with the Resizer.
fn resize_start(x, y) {
    drag_x0 = x
    drag_w0 = preview_w
}

fn resize_move(x, y) {
    preview_w = drag_w0 + (drag_x0 - x) / viewport_width * 100
    if preview_w < 25 { preview_w = 25 }
    if preview_w > 50 { preview_w = 50 }
}

ui fn Sandbox() {
    state theme = storage_get_or("theme", "dark")
    state code = storage_get_or("sandbox-code", include_str("../../examples/ui_app.tn"))
    state preview_w = 33.333
    state drag_x0 = 0
    state drag_w0 = 0
    import "./landing/chrome.tn";

    theme::dark {
        Page {
            layout::{ direction::column, height::"100dvh", overflow::hidden }
            paint::{ background::#0a0a0a, color::#d0d0d0 }
            color-scheme::{ theme }
            font-family::"Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
            max-800::{ height::auto, min-height::"100%", overflow::visible }
            import "./landing/topbar.tn";

            Workspace {
                layout::{ grid::{ columns::{ "minmax(0, 1fr) 6px minmax(0, " + preview_w + "%)" }, gap::0 }, grow::1, min-width::0, min-height::0, height::"100%", overflow::hidden }
                mobile::{ grid::{ columns::"1fr" } }
                max-800::{ display::flex, direction::column, height::auto, overflow::visible }
                CodeColumn {
                    layout::{ direction::column, min-width::0, min-height::0, height::"100%", overflow::hidden }
                    flex::"1 1 0"
                    max-800::{ flex::none, width::"100%", height::auto }
                    CodePanel {
                        layout::{ direction::column, padding::14, min-width::0, min-height::0, height::0, overflow::hidden }
                        flex::"1 1 0"
                        paint::{ background::#141414 }
                        max-800::{ height::"58vh", min-height::360, max-height::620 }
                        max-480::{ height::"55vh", min-height::300 }
                        import "./editor/editor.tn";
                    }
                }
                Resizer {
                    layout::{ min-width::0 }
                    cursor::col-resize
                    touch-action::none
                    pointer_start||resize_start
                    pointer_move||resize_move
                    paint::{ background::#2b2b2b }
                    motion::{ hover::{ background::#9a9a9a } }
                    max-800::{ display::none }
                }
                PreviewPanel {
                    layout::{ direction::column, min-width::0, min-height::0, height::"100%", overflow::hidden }
                    paint::{ background::#161616 }
                    max-800::{ flex::none, width::"100%", height::auto, min-height::420 }
                    max-480::{ min-height::360 }
                    PreviewMount {
                        layout::{ grow::1, min-height::0, overflow::auto }
                        Preview { layout::{ width::"100%", min-height::"100%" } entry||"App" "{code}" }
                    }
                }
            }
        }
    }

    theme::light {
        Page {
            layout::{ direction::column, height::"100dvh", overflow::hidden }
            paint::{ background::#ffffff, color::#353535 }
            color-scheme::{ theme }
            font-family::"Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
            max-800::{ height::auto, min-height::"100%", overflow::visible }
            import "./landing/topbar.tn";

            Workspace {
                layout::{ grid::{ columns::{ "minmax(0, 1fr) 6px minmax(0, " + preview_w + "%)" }, gap::0 }, grow::1, min-width::0, min-height::0, height::"100%", overflow::hidden }
                mobile::{ grid::{ columns::"1fr" } }
                max-800::{ display::flex, direction::column, height::auto, overflow::visible }
                CodeColumn {
                    layout::{ direction::column, min-width::0, min-height::0, height::"100%", overflow::hidden }
                    flex::"1 1 0"
                    max-800::{ flex::none, width::"100%", height::auto }
                    CodePanel {
                        layout::{ direction::column, padding::14, min-width::0, min-height::0, height::0, overflow::hidden }
                        flex::"1 1 0"
                        paint::{ background::#f5f5f5 }
                        max-800::{ height::"58vh", min-height::360, max-height::620 }
                        max-480::{ height::"55vh", min-height::300 }
                        import "./editor/editor.tn";
                    }
                }
                Resizer {
                    layout::{ min-width::0 }
                    cursor::col-resize
                    touch-action::none
                    pointer_start||resize_start
                    pointer_move||resize_move
                    paint::{ background::#e0e0e0 }
                    motion::{ hover::{ background::#6a6a6a } }
                    max-800::{ display::none }
                }
                PreviewPanel {
                    layout::{ direction::column, min-width::0, min-height::0, height::"100%", overflow::hidden }
                    paint::{ background::#f5f5f5 }
                    max-800::{ flex::none, width::"100%", height::auto, min-height::420 }
                    max-480::{ min-height::360 }
                    PreviewMount {
                        layout::{ grow::1, min-height::0, overflow::auto }
                        Preview { layout::{ width::"100%", min-height::"100%" } entry||"App" "{code}" }
                    }
                }
            }
        }
    }
}
