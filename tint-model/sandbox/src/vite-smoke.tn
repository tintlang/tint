ui fn Smoke() {
    Page {
        layout::{ padding::32, direction::column, gap::12, min-height::420 }
        paint::{ background::#101018, color::#ffffff }
        Headline { text::{28, bold} "Tint + Vite works" }
        Text { text::{14, #b8b8c8} "Loaded from a .tn module through @tintlang/vite." }
        Link {
            route||"https://github.com/tintlang/tint"
            target||"_blank"
            paint::{ color::#8b7cf0 }
            text-decoration::"none"
            motion::{ transition::"color .15s ease", hover::{ color::#b7a8ff } }
            "Open GitHub"
        }
    }
}
