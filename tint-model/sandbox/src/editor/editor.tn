// A code editor written in Tint: a transparent TextArea over a layer of
// highlighted text (`tint_highlight` runs the real lexer). Spliced into a
// container inside a `ui fn` with `state code` and `theme`.
Editor {
    layout::{ grow::1, min-width::0, min-height::0, overflow::auto }
    Document {
        layout::{ direction::row, width::"max-content", min-width::"100%", min-height::"100%" }
        font-family::"ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
        size::13
        line-height::"22px"
        Gutter {
            position::sticky
            left::0
            z::1
            layout::{ padding.x::12 }
            text-align::right
            white-space::pre
            color::{ hl_color("gutter", theme) }
            background::@panel-bg
            "{line_numbers(code)}"
        }
        Body {
            position::relative
            layout::{ grow::1 }
            min-width::{ "" + (max_line_len(code) + 4) + "ch" }
            height::{ line_count(code) * 22 }
            Layer {
                position::absolute
                inset::0
                white-space::pre
                pointer-events::none
                for{seg in tint_highlight(code)}
                Text { color::{ hl_color(seg[1], theme) } font-style::{ hl_style(seg[1]) } "{seg[0]}" }
            }
            TextArea {
                position::absolute
                inset::0
                width::"100%"
                height::"100%"
                white-space::pre
                color::transparent
                caret-color::{ hl_color("plain", theme) }
                tab-size::2
                input||on_code_edit
                "{code}"
            }
        }
    }
}
