theme::dark {
    tokens {
        text-main::white
        text-muted::#9a9a9a
        button-bg::#ffffff
        button-text::#0a0a0a
        button-outline-text::#ffffff
        button-border::#ffffff
        button-padding::18
    }
}

theme::light {
    tokens {
        text-main::#0a0a0a
        text-muted::#6a6a6a
        button-bg::#0a0a0a
        button-text::#ffffff
        button-outline-text::#0a0a0a
        button-border::#0a0a0a
        button-padding::16
    }
}

style HeroLayout {
    layout::{ direction::column, align::center, gap::22, padding.x::40, padding.y::100 }
    mobile::{ padding.y::40, gap::18 }
}

style CenteredOnSmall {
    mobile::{ width::"100%", text-align::center }
    tablet::{ width::"100%", text-align::center }
}

style ButtonBase {
    layout::{ padding.x::@button-padding, padding.y::10 }
    paint::{ radius::full }
    motion::{ transition::"transform .2s ease", hover::{ scale::1.06 } }
}

component ActionButton {
    use::ButtonBase

    variant::solid {
        paint::{ background::@button-bg, color::@button-text }
    }

    variant::outline {
        paint::{ background::transparent, color::@button-outline-text, border::{1, @button-border} }
    }

    slot::content
}

Hero {
    use::HeroLayout

    Headline { use::CenteredOnSmall text::{54, bold, @text-main} "This page is written in Tint.tn" }
    Sub { use::CenteredOnSmall text::{18, @text-muted} "A small declarative UI DSL for Rust/WASM. No React or Svelte. Compiled to WebAssembly and rendered directly to the DOM." }

    CtaRow {
        layout::{ direction::row, gap::12 }
        mobile::{ direction::column }

        ActionButton {
            variant::solid
            click||open_sandbox
            route||"/sandbox"
            "Sandbox"
        }

        ActionButton {
            variant::outline
            click||open_github
            "GitHub"
        }
    }
}
