Hero {
    use::HeroLayout

    Headline {
        use::CenteredOnSmall
        animation::"rise .7s cubic-bezier(.2,.7,.2,1) both"
        Text {
            text::{54, bold, @text-main}
            "This page is written in "
            Inline {
                white-space::"nowrap"
                "Tint"
                Inline {text::{18, bold, @text-main} ".tn" }
            }
        }
    }
    Sub { use::CenteredOnSmall animation::"rise .7s .12s cubic-bezier(.2,.7,.2,1) both" text::{18, @text-muted} "A declarative UI language that compiles to WebAssembly. Write your interface once in Tint, no HTML, CSS or JavaScript." }

    CtaRow {
        layout::{ direction::row, gap::12 }
        animation::"rise .7s .24s cubic-bezier(.2,.7,.2,1) both"
        mobile::{ direction::column }

        ActionButton {
            variant::solid
            click||open_sandbox
            route||"/sandbox"
            "Sandbox"
        }

        ActionButton {
            variant::outline
            route||"https://github.com/tintlang/tint"
            target||"_blank"
            "GitHub"
        }
    }
}
