// Landing shell. Section files are expanded here by the .tn import loader.
import "./landing-actions.tn";

ui fn Landing() {
    state theme = storage_get_or("theme", "dark")
    state code = include_str("./demo-app.tn")
    import "./chrome.tn";

    style HeroLayout {
        layout::{ direction::column, align::center, gap::22, padding.x::40, padding.y::100 }
        mobile::{ padding.y::40, gap::18 }
    }

    style CenteredOnSmall {
        mobile::{ width::"100%", text-align::center }
        tablet::{ width::"100%", text-align::center }
    }

    style ButtonBase {
        layout::{ padding.x::@button-padding, padding.y::10 }
        paint::{ radius::full }
        motion::{ transition::"transform .2s ease", hover::{ scale::1.06 } }
    }

    style DemoBase {
        layout::{ direction::column, gap::20, padding::64 }
        mobile::{ padding::28 }
    }

    style SourceRenderBase {
        layout::{ grid::{ columns::"minmax(0, 2fr) minmax(0, 1fr)", gap::24 }, min-width::0 }
        mobile::{ grid::{ columns::"1fr" } }
    }

    style CodePanelBase {
        layout::{ grow::1, direction::column, padding::24, min-width::0, min-height::280, overflow::hidden }
        paint::{ radius::16, background::@panel-bg, border::{1, @panel-border}, color::@panel-text }
        font-family::"ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
        size::13
    }

    style PreviewPanelBase {
        layout::{ grow::1, direction::column, align::center, justify::center, padding::24, min-width::0, min-height::280, overflow::hidden }
        paint::{ radius::16, background::@panel-alt, border::{1, @panel-border} }
    }

    style CaptionBase {
        layout::{ width::"100%", align::center }
        text-align::center
        text::{13, @text-muted}
    }

    style PongButtonBase {
        layout::{ align::center, padding.x::34, padding.y::18 }
        paint::{ radius::full, background::@button-bg, color::@button-text }
        size::18
        font-weight::bold
        motion::{ transition::"transform .2s ease, background .2s ease", hover::{ scale::1.04, background::@pong-hover } }
    }

    style FooterBase {
        layout::{ padding.y::26, align::center, justify::center, direction::row, gap::6 }
        paint::{ border::{1, @footer-border} }
    }

    style RepoLinkBase {
        text::{12, @text-muted}
        motion::{ hover::{ text-decoration::"underline" } }
    }

    component ActionButton {
        use::ButtonBase
        variant::solid {
            paint::{ background::@button-bg, color::@button-text }
        }
        variant::outline {
            paint::{ background::transparent, color::@button-outline-text, border::{1, @button-border} }
        }
        slot::content
    }

    component PongButton {
        use::PongButtonBase
        slot::content
    }

    component RepoLink {
        use::RepoLinkBase
        slot::content
    }

    Page {
        color-scheme::{ theme }
        layout::{ direction::column }
        paint::{ background::@page-bg }
        import "./topbar.tn";
        import "./hero.tn";
        import "./demo.tn";
        import "./footer.tn";
    }
}
