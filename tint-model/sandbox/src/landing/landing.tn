// Landing shell. Section files are expanded here by the .tn import loader.
import "./landing-actions.tn";

ui fn Landing() {
    state theme = storage_get_or("theme", "dark")
    state code = include_str("./demo-app.tn")
    state tint_src = include_str("./demo-counter.tn")
    state compare_file = "index.html"
    state web_shown = include_str("./compare/index.html.txt")
    state web_index = include_str("./compare/index.html.txt")
    state web_main = include_str("./compare/main.jsx.txt")
    state web_app = include_str("./compare/App.jsx.txt")
    state web_css = include_str("./compare/App.css.txt")
    import "./chrome.tn";

    style HeroLayout {
        layout::{ direction::column, align::center, gap::22, padding.x::40, padding.t::100, padding.b::16 }
        mobile::{ padding.y::40, gap::18 }
    }

    style CenteredOnSmall {
        mobile::{ width::"100%", text-align::center }
        tablet::{ width::"100%", text-align::center }
    }

    style ButtonBase {
        layout::{ padding.x::@button-padding, padding.y::10 }
        paint::{ radius::full }
        motion::{
            spring::{ stiffness::420, damping::16, props::"transform" },
            hover::{ scale::1.06 },
            tap::{ scale::0.94 },
            focus-visible::{ ring::{3, #8b7cf0} }
        }
    }

    style DemoBase {
        layout::{ direction::column, gap::20, padding::64 }
        mobile::{ padding::28 }
    }

    style SourceRenderBase {
        layout::{ grid::{ columns::"minmax(0, 2fr) minmax(0, 1fr)", gap::24 }, min-width::0 }
        mobile::{ grid::{ columns::"1fr" } }
    }

    style CodePanelBase {
        layout::{ grow::1, direction::column, padding::24, min-width::0, min-height::280, overflow::hidden }
        paint::{ radius::16, background::@panel-bg, border::{1, @panel-border}, color::@panel-text }
        font-family::"ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
        size::13
    }

    style PreviewPanelBase {
        layout::{ grow::1, direction::column, align::center, justify::center, padding::24, min-width::0, min-height::280, overflow::hidden }
        paint::{ radius::16, background::@panel-alt, border::{1, @panel-border} }
    }

    style CompareBase {
        layout::{ direction::column, align::center, gap::14, width::"100%", margin.t::48 }
    }

    style VersusBase {
        layout::{ grid::{ columns::"minmax(0, 1fr) auto minmax(0, 1fr)", gap::20 }, width::"100%", align::center, margin.t::22 }
        mobile::{ grid::{ columns::"1fr" } }
    }

    style SideBase {
        layout::{ direction::column, min-width::0, overflow::hidden }
        paint::{ radius::20, background::@panel-bg, border::{1, @panel-border} }
    }

    style SideTop {
        layout::{ direction::column, align::center, justify::center, gap::10, padding::24, height::320 }
        paint::{ border.b::{1, @panel-border} }
    }

    style SideBottom {
        layout::{ direction::column, height::330, overflow::hidden }
    }

    style ChipBase {
        layout::{ direction::row, align::center, gap::12, padding.x::14, padding.y::12, width::"100%", max-width::260 }
        paint::{ radius::full, background::@panel-alt, border::{1, @panel-border} }
        motion::{ transition::"background .15s ease", hover::{ background::@control-hover } }
        cursor::pointer
        font-family::"ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    }

    style CaptionBase {
        layout::{ width::"100%", align::center }
        text-align::center
        text::{13, @text-muted}
    }

    style PongButtonBase {
        layout::{ align::center, padding.x::120, padding.y::26 }
        paint::{ radius::full, background::@button-bg, color::@button-text }
        size::24
        font-weight::bold
        motion::{ transition::"transform .2s ease, background .2s ease", hover::{ scale::1.04, background::@pong-hover } }
    }

    style FooterBase {
        layout::{ padding.y::26, align::center, justify::center, direction::row, gap::6 }
        paint::{ border::{1, @footer-border} }
    }

    style RepoLinkBase {
        text::{12, @text-muted}
        motion::{ hover::{ text-decoration::"underline" } }
    }

    component ActionButton {
        use::ButtonBase
        variant::solid {
            paint::{ background::@button-bg, color::@button-text }
            animation::"ring-pulse 2.4s ease-out infinite"
        }
        variant::outline {
            paint::{ background::transparent, color::@button-outline-text, border::{1, @button-border} }
        }
        slot::content
    }

    component PongButton {
        use::PongButtonBase
        slot::content
    }

    component RepoLink {
        use::RepoLinkBase
        slot::content
    }

    Page {
        color-scheme::{ theme }
        layout::{ direction::column }
        paint::{ background::@page-bg }
        import "./topbar.tn";
        Main {
            layout::{ direction::column, align::center, width::"100%" }
            Content {
                layout::{ direction::column, width::"100%", max-width::1440 }
                import "./hero.tn";
                import "./demo.tn";
            }
        }
        import "./footer.tn";
    }
}
