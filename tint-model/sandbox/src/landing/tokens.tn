theme::dark {
    tokens {
        page-bg::#0a0a0a
        nav-bg::"rgba(255,255,255,0.08)"
        nav-border::#2b2b2b
        logo-text::white
        logo-hover::#2b2b2b
        text-main::white
        text-muted::#9a9a9a
        control-bg::#161616
        control-hover::#2b2b2b
        panel-bg::#141414
        panel-alt::#161616
        panel-border::#2b2b2b
        panel-text::#d0d0d0
        footer-border::#2b2b2b
        button-bg::#ffffff
        button-text::#0a0a0a
        button-outline-text::#ffffff
        button-border::#ffffff
        button-padding::18
        button-hover::#f0f0f0
        pong-hover::#e8e8e8
        theme-dark-bg::#ffffff
        theme-dark-text::#0a0a0a
        theme-light-bg::transparent
        theme-light-text::#9a9a9a
    }
}

theme::light {
    tokens {
        page-bg::#ffffff
        nav-bg::"rgba(255,255,255,0.72)"
        nav-border::#e0e0e0
        logo-text::#0a0a0a
        logo-hover::#eaeaea
        text-main::#0a0a0a
        text-muted::#6a6a6a
        control-bg::#f5f5f5
        control-hover::#e2e2e2
        panel-bg::#f5f5f5
        panel-alt::#f5f5f5
        panel-border::#e0e0e0
        panel-text::#353535
        footer-border::#e0e0e0
        button-bg::#0a0a0a
        button-text::#ffffff
        button-outline-text::#0a0a0a
        button-border::#0a0a0a
        button-padding::16
        button-hover::#202020
        pong-hover::#252525
        theme-dark-bg::transparent
        theme-dark-text::#6a6a6a
        theme-light-bg::#0a0a0a
        theme-light-text::#ffffff
    }
}
