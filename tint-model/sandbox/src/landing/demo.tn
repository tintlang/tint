Demo {
    use::DemoBase

    SourceRender {
        use::SourceRenderBase
        CodePanel {
            use::CodePanelBase
            import "../editor/editor.tn";
        }
        PreviewPanel {
            use::PreviewPanelBase
            Preview { entry||"App" "{code}" }
        }
    }

    Caption2 {
        use::CaptionBase
        "No screenshot — the panel on the right is a live DomSession render of the source on the left."
    }

    PongButton { route||"/pong" "Open Pong" }
}
