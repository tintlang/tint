Demo {
    use::DemoBase

    SourceRender {
        use::SourceRenderBase
        CodePanel {
            use::CodePanelBase
            import "../editor/editor.tn";
        }
        PreviewPanel {
            use::PreviewPanelBase
            Preview { entry||"App" "{code}" }
        }
    }

    import "./compare.tn";

    PongBlock {
        layout::{ direction::column, align::center, gap::28, margin.t::72, padding.b::24 }
        Text { use::CenteredOnSmall text::{28..44, bold, @text-main} "Mini app on Tint" }
        PongButton { route||"/pong" "Pong game" }
    }
}
