Compare {
    use::CompareBase

    CompareTitle {
        use::CenteredOnSmall
        use::Reveal
        Text { text-align::center text::{28..44, bold, @text-main} "Same app. Less scaffolding." }
    }
    Sub { use::CenteredOnSmall use::Reveal text::{15..17, @text-muted} "One Tint file, or four files in Vite + React." }

    Versus {
        use::VersusBase

        Side {
            use::SideBase
            use::Reveal
            Top {
                use::SideTop
                Text { text::{13, @text-muted} "Tint" }
                Chip {
                    use::ChipBase
                    layout::{ padding.y::16, padding.x::18 }
                    background::{ chip_bg("app.tn", "app.tn", theme) }
                    Icon { layout::{ width::28, height::28 } svg||"<svg viewBox='0 0 512 512' width='28' height='28' fill='none'><path d='M289.115 404.552C289.115 391.341 289.115 378.561 289.115 366.214C289.115 353.744 289.115 339.854 289.115 324.543V306.023C289.115 291.824 289.115 277.563 289.115 263.241C289.115 248.918 289.115 234.41 289.115 219.717L335.601 216.939L338.009 249.165H342.639C346.837 243.115 351.899 237.497 357.826 232.311C363.752 227.002 370.543 222.742 378.198 219.532C385.977 216.322 394.805 214.717 404.683 214.717C423.203 214.717 437.217 220.211 446.724 231.2C456.231 242.065 460.985 258.363 460.985 280.094C460.985 288.243 460.985 295.837 460.985 302.874C460.985 309.789 460.985 317.012 460.985 324.543C460.985 339.607 460.985 353.435 460.985 366.029C460.985 378.5 460.985 391.341 460.985 404.552H405.794C405.794 391.341 405.794 378.561 405.794 366.214C405.794 353.867 405.794 340.965 405.794 327.507V297.874C405.794 287.008 404.004 278.859 400.423 273.427C396.842 267.871 390.422 265.093 381.162 265.093C375.852 265.093 370.975 266.204 366.53 268.426C362.085 270.525 358.011 273.427 354.307 277.131C350.603 280.712 347.331 284.724 344.491 289.169V327.507C344.491 341.335 344.491 354.361 344.491 366.585C344.491 378.685 344.491 391.341 344.491 404.552H289.115Z' fill='#C64CCC'/><path d='M211.569 409.553C197.864 409.553 186.134 407.516 176.38 403.441C166.75 399.243 159.341 392.576 154.156 383.439C149.093 374.302 146.562 362.264 146.562 347.324C146.562 339.298 146.562 331.088 146.562 322.692C146.562 314.172 146.562 305.282 146.562 296.022C146.562 286.762 146.562 277.008 146.562 266.76C146.562 256.512 146.562 245.461 146.562 233.608C146.562 219.656 146.562 206.877 146.562 195.271C146.562 183.665 146.562 171.811 146.562 159.711L201.013 149.896C201.013 159.526 201.013 168.663 201.013 177.306C201.013 185.825 201.013 194.653 201.013 203.79C201.013 212.803 201.013 222.743 201.013 233.608V329.915C201.013 341.15 203.05 349.732 207.124 355.658C211.322 361.461 218.113 364.363 227.497 364.363C231.448 364.363 235.769 363.684 240.461 362.326C245.153 360.844 249.66 358.56 253.981 355.473L257.13 400.293C253.919 402.268 249.845 403.935 244.906 405.293C239.967 406.651 234.596 407.701 228.793 408.442C222.99 409.182 217.249 409.553 211.569 409.553ZM116.559 261.389V219.718H256.204V261.389C244.597 261.389 232.93 261.389 221.2 261.389C209.594 261.389 198.358 261.389 187.493 261.389H162.86H116.559Z' fill='#C64CCC'/><path d='M80.4672 409.553C73.3059 409.553 67.1324 408.071 61.9467 405.108C56.8844 402.144 52.9334 398.132 50.0936 393.069C47.3772 387.884 46.019 382.142 46.019 375.845C46.019 366.215 49.1058 358.313 55.2793 352.139C61.4528 345.966 69.9105 342.879 80.6524 342.879C87.8136 342.879 93.9254 344.299 98.9877 347.139C104.173 349.855 108.124 353.744 110.841 358.807C113.681 363.745 115.1 369.425 115.1 375.845C115.1 385.353 112.014 393.378 105.84 399.922C99.7902 406.342 91.3325 409.553 80.4672 409.553Z' fill='#C64CCC'/></svg>" }
                    Text { text::{16, @text-main} "app.tn" }
                }
            }
            Bottom {
                use::SideBottom
                import "../editor/viewer-tint.tn";
            }
        }

        Vs { text::{16, bold, @text-main} text-align::center justify-self::center "VS" }

        Side {
            use::SideBase
            use::RevealLate
            Top {
                use::SideTop
                Text { text::{13, @text-muted} "HTML + CSS + JS" }
                Chip {
                    use::ChipBase
                    click||pick_web_index
                    background::{ chip_bg(compare_file, "index.html", theme) }
                    Icon { layout::{ width::22, height::22 } svg||"<svg viewBox='0 0 32 32' width='22' height='22'><path fill='#e44f26' d='M5.902 27.201L3.655 2h24.69l-2.25 25.197L15.985 30z'/><path fill='#f1662a' d='m16 27.858l8.17-2.265l1.922-21.532H16z'/><path fill='#ebebeb' d='M16 13.407h-4.09l-.282-3.165H16V7.151H8.25l.074.83l.759 8.517H16zm0 8.027l-.014.004l-3.442-.929l-.22-2.465H9.221l.433 4.852l6.332 1.758l.014-.004z'/><path fill='#fff' d='M15.989 13.407v3.091h3.806l-.358 4.009l-3.448.93v3.216l6.337-1.757l.046-.522l.726-8.137l.076-.83zm0-6.256v3.091h7.466l.062-.694l.141-1.567l.074-.83z'/></svg>" }
                    Text { text::{14, @text-main} "index.html" }
                }
                Chip {
                    use::ChipBase
                    click||pick_web_main
                    background::{ chip_bg(compare_file, "main.jsx", theme) }
                    Icon { layout::{ width::24, height::24 } svg||"<svg viewBox='-12 -12 24 24' width='24' height='24' fill='none' stroke='#61dafb' stroke-width='1'><circle r='2' fill='#61dafb' stroke='none'/><ellipse rx='10' ry='4'/><ellipse rx='10' ry='4' transform='rotate(60)'/><ellipse rx='10' ry='4' transform='rotate(120)'/></svg>" }
                    Text { text::{14, @text-main} "main.jsx" }
                }
                Chip {
                    use::ChipBase
                    click||pick_web_app
                    background::{ chip_bg(compare_file, "App.jsx", theme) }
                    Icon { layout::{ width::24, height::24 } svg||"<svg viewBox='-12 -12 24 24' width='24' height='24' fill='none' stroke='#61dafb' stroke-width='1'><circle r='2' fill='#61dafb' stroke='none'/><ellipse rx='10' ry='4'/><ellipse rx='10' ry='4' transform='rotate(60)'/><ellipse rx='10' ry='4' transform='rotate(120)'/></svg>" }
                    Text { text::{14, @text-main} "App.jsx" }
                }
                Chip {
                    use::ChipBase
                    click||pick_web_css
                    background::{ chip_bg(compare_file, "App.css", theme) }
                    Icon { layout::{ width::22, height::22 } svg||"<svg viewBox='0 0 32 32' width='22' height='22'><path fill='#639' d='M1.995 1.994h23.52a4.48 4.48 0 0 1 4.48 4.48v19.04a4.48 4.48 0 0 1-4.48 4.48H6.475a4.48 4.48 0 0 1-4.48-4.48Z'/><path fill='#fff' d='M9.079 24.87v-4.704c0-1.876 1.204-2.884 3.024-2.884c1.792-.028 2.912 1.148 2.856 3.136h-2.072c.056-.756-.28-1.316-.84-1.288c-.7 0-.896.476-.896 1.372v4.088c0 .868.28 1.288.896 1.316c.644 0 .896-.644.84-1.372h2.072c.112 2.044-1.176 3.248-2.996 3.22c-1.764 0-2.884-.98-2.884-2.884m6.636-.336h1.932c.028.896.308 1.456.924 1.456s.84-.364.84-1.204c0-.7-.308-1.092-1.064-1.456l-.728-.336c-1.288-.616-1.82-1.372-1.82-2.884c0-1.68 1.064-2.856 2.8-2.856s2.66 1.204 2.688 3.164h-1.876c0-.812-.168-1.372-.784-1.372c-.56 0-.84.28-.84.98s.252.98.924 1.26l.672.308c1.428.672 2.044 1.54 2.044 3.164c0 1.932-1.092 2.996-2.884 2.996s-2.8-1.232-2.828-3.22m6.328 0h1.96c0 .896.308 1.456.896 1.456s.84-.364.84-1.204c0-.7-.28-1.092-1.064-1.456l-.728-.336c-1.288-.616-1.792-1.372-1.792-2.884c0-1.68 1.036-2.856 2.8-2.856s2.632 1.204 2.688 3.164h-1.876c-.028-.812-.196-1.372-.812-1.372c-.56 0-.812.28-.812.98s.224.98.896 1.26l.7.308c1.4.672 2.016 1.54 2.016 3.164c0 1.932-1.092 2.996-2.884 2.996s-2.8-1.232-2.828-3.22'/></svg>" }
                    Text { text::{14, @text-main} "App.css" }
                }
            }
            Bottom {
                use::SideBottom
                import "../editor/viewer-web.tn";
            }
        }
    }

}
