theme::dark {
    Footer {
        layout::{ padding.y::26, align::center, justify::center, direction::row, gap::6 }
        paint::{ border::{1, #2b2b2b} }
        Text { text::{12, #9a9a9a} "Unlicense (public domain) ·" }
        RepoLink { click||open_github text::{12, #9a9a9a} motion::{ hover::{ text-decoration::"underline" } } "github.com/tintlang/tint" }
    }
}
theme::light {
    Footer {
        layout::{ padding.y::26, align::center, justify::center, direction::row, gap::6 }
        paint::{ border::{1, #e0e0e0} }
        Text { text::{12, #6a6a6a} "Unlicense (public domain) ·" }
        RepoLink { click||open_github text::{12, #6a6a6a} motion::{ hover::{ text-decoration::"underline" } } "github.com/tintlang/tint" }
    }
}

