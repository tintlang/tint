// The whole site is one Tint program: each page is a `ui fn`, and `route.*`
// tells the browser host which one to render for which URL.
import "./editor/editor-fns.tn";
import "./landing/landing.tn";
import "./tint-pong/pong.tn";
import "./sandbox.tn";

app {
    lang::"en"
    router::on
    js::"./landing/copy.js"
    page::{ margin::0, font-family::"-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif" }
    keyframes.rise::{
        from::{ opacity::0, translate.y::18 },
        to::{ opacity::1, translate.y::0 }
    }
    keyframes.ring-pulse::{
        from::{ shadow::"0 0 0 0 rgba(130,120,240,.55)" },
        to::{ shadow::"0 0 0 16px rgba(130,120,240,0)" }
    }
    route.Landing::{ path::"/", title::"Tint" }
    route.PongGame::{ path::"/pong", title::"Tint Pong" }
    route.Sandbox::{ path::"/sandbox", title::"Tint Sandbox" }
}
