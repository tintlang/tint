{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/install", "destination": "https://raw.githubusercontent.com/tintlang/tint/main/scripts/install-tint.sh", "permanent": false }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
