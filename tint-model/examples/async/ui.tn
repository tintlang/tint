app {
    title::"Async"
    js::"./wait.js"
    rs::"./native.rs"
}

// `await` turns the rest of the body into the callback of the call.
async fn run() {
    status = "waiting..."
    await wait(400)
    let squared: number = await slow_square(7)
    status = "squared: {squared}"
    let bad: number = await slow_square(-1)
    status = "{status}, then: {bad}"
}

// Without `await`: pass the callback yourself.
fn run_plain() {
    wait(200, |r: Result<number, string>| { status = "plain callback got {r}" })
}

ui fn App() {
    state status = "idle"

    Column {
        direction::column
        padding::24
        gap::8
        Text { text::{16, white} "{status}" }
        Button { click||run "await" }
        Button { click||run_plain "callback" }
    }
}
