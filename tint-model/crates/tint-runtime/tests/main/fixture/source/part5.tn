use math;


//     GLOBAL DESTRUCT PATTERNS

fn __global_tests__() {
    let (x, y) = p;
    let (a, (b, c)) = nested;
    let (_, y2) = pair;
}

//     FUNCTION PARAM PATTERNS
// tuple params
fn foo1((x, y)) {
    x + y
}

// nested tuple params
fn foo2((a, (b, c))) {
    a + b + c
}

// struct params
fn foo3(User { id, name }) {
    id * 100
}

// typed param
fn typed1(x: i32) {
    x + 1
}

// typed tuple destruct
fn typed2((a: i32, b)) {
    a * 10 + b
}


