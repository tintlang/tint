    let b = map {
        x{ map {
            y{ map {
                z{ 99 }
            }}
        }},
        list{ [ (1,2) (3,4) (5, [6,7,8]) ] },
        user{
            User {
                id: a.2.id,
                name: "Deep",
                age: a.2.age + 1
            }
        }
    };

    let c = match a.1 {
        (x, (y, (z, k))) => x + y + z + k,
        _ => 0,
    };

    let d = match b {
        map {
            x{ map {
                y{ map { z } }
            }},
            user{ User { id, name } },
            list
        } => z + id + name.len(),
        _ => 0
    };

    let op = Option::Some { value: map {
        inner{ [1,2,3] },
        deep{ User { id: 5, name: "X", age: 7 } }
    }};

    let r = match op {
        Some { value{ inner, deep } } => {
            let mul = |a, b| a * b;
            mul(inner[1], deep.age)
        },
        None {} => 0
    };

    borrow(frame) {
        borrow@group(invert) {
            // nested borrow blocks allowed
            convolve(frame, invert)
        }
    }

    // combine results for sanity
    c + d + r
}

